{
  "device": "JohnMayerX",
  "match": [
    "John Mayer"
  ],
  "switches": {
    "amp": {
      "param": [
        "selectedAmp",
        "Amp",
        "Amp Type",
        "Selected Amp"
      ],
      "count": 4
    }
  },
  "banks": [
    {
      "name": "PRE DRIVE",
      "controls": [
        {
          "label": "Teal On",
          "type": "toggle",
          "param": "overdriveActive"
        },
        {
          "label": "Teal Gain",
          "param": "overdriveGain"
        },
        {
          "label": "Teal Tone",
          "param": "overdriveTone"
        },
        {
          "label": "Teal Level",
          "param": "overdriveLevel"
        },
        {
          "label": "Halfman On",
          "type": "toggle",
          "param": "centaurActive"
        },
        {
          "label": "Halfman Gain",
          "param": "centaurGain"
        },
        {
          "label": "Halfman Treb",
          "param": "centaurTreble"
        },
        {
          "label": "Halfman Lvl",
          "param": "centaurLevel"
        }
      ]
    },
    {
      "name": "PRE FX",
      "controls": [
        {
          "label": "Filter On",
          "type": "toggle",
          "param": "qTronActive"
        },
        {
          "label": "Filter Gain",
          "param": "qTronGain"
        },
        {
          "label": "Filter Peak",
          "param": "qTronPeak"
        },
        {
          "label": "Boost On",
          "type": "toggle",
          "param": "katanaActive"
        },
        {
          "label": "Boost Out",
          "param": "katanaOutput"
        },
        {
          "label": "Milli On",
          "type": "toggle",
          "param": "aquapussActive"
        },
        {
          "label": "Milli Blend",
          "param": "aquapussBlend"
        },
        {
          "label": "Milli Time",
          "param": "aquapussTime"
        }
      ]
    },
    {
      "name": "AMP",
      "controls": [
        {
          "label": "Amp",
          "type": "menu",
          "items": [
            "Smooth Op",
            "Headroom",
            "Sig 83",
            "3-in-1"
          ],
          "param": [
            "selectedAmp",
            "Amp",
            "Amp Type",
            "Selected Amp"
          ],
          "sets": "amp"
        },
        {
          "label": "Gain",
          "by": "amp",
          "params": [
            "dumbleGain",
            "vibroverbVolume",
            "twoRockGain",
            "threeInOneGain"
          ],
          "labels": [
            "Gain",
            "Volume",
            "Gain",
            "Gain"
          ]
        },
        {
          "label": "Bass",
          "by": "amp",
          "params": [
            "dumbleBass",
            "vibroverbBass",
            "twoRockBass",
            null
          ]
        },
        {
          "label": "Mid",
          "by": "amp",
          "params": [
            "dumbleMid",
            null,
            "twoRockMid",
            null
          ]
        },
        {
          "label": "Treble",
          "by": "amp",
          "params": [
            "dumbleTreble",
            "vibroverbTreble",
            "twoRockTreble",
            null
          ]
        },
        {
          "label": "Presence",
          "by": "amp",
          "params": [
            null,
            null,
            "twoRockPresence",
            null
          ]
        },
        {
          "label": "Master",
          "by": "amp",
          "params": [
            "dumbleMaster",
            null,
            "twoRockMaster",
            null
          ]
        },
        {
          "label": "Amp Out",
          "by": "amp",
          "params": [
            "dumbleOutput",
            "vibroverbOutput",
            "twoRockOutput",
            "threeInOneOutput"
          ]
        }
      ]
    },
    {
      "name": "AMP 2",
      "controls": [
        {
          "label": "Bright",
          "by": "amp",
          "params": [
            "dumbleBright",
            "vibroverbBright",
            "twoRockBright",
            null
          ],
          "type": "toggle"
        },
        {
          "label": "Mid Boost",
          "by": "amp",
          "params": [
            "dumbleMidBoost",
            null,
            null,
            null
          ],
          "type": "toggle"
        },
        {
          "label": "Input Jack",
          "by": "amp",
          "params": [
            "dumbleInputJack",
            null,
            null,
            null
          ],
          "type": "toggle"
        },
        {
          "label": "Amp EQ",
          "by": "amp",
          "params": [
            null,
            null,
            "twoRockEQ",
            null
          ]
        },
        {
          "label": "3in1 SmOp",
          "param": "threeInOneDumbleOutput"
        },
        {
          "label": "3in1 Headrm",
          "param": "threeInOneVibroverbOutput"
        },
        {
          "label": "3in1 Sig83",
          "param": "threeInOneTwoRockOutput"
        },
        {
          "label": "3in1 Room",
          "param": "threeInOneRoomSend"
        }
      ]
    },
    {
      "name": "VERB/TREM",
      "controls": [
        {
          "label": "Spring On",
          "type": "toggle",
          "param": "springReverbActive"
        },
        {
          "label": "Spring Mix",
          "param": "springReverbMix"
        },
        {
          "label": "Spring Tone",
          "param": "springReverbTone"
        },
        {
          "label": "Spring Decay",
          "param": "springReverbDecay"
        },
        {
          "label": "Trem On",
          "type": "toggle",
          "param": "reverberatoActive"
        },
        {
          "label": "Trem Speed",
          "param": "reverberatoSpeed"
        },
        {
          "label": "Trem Intens",
          "param": "reverberatoIntensity"
        },
        {
          "label": "Trem Sync",
          "type": "toggle",
          "param": "reverberatoSync"
        }
      ]
    },
    {
      "name": "EQ/COMP",
      "controls": [
        {
          "label": "EQ On",
          "by": "amp",
          "params": [
            "dumbleEQActive",
            "vibroverbEQActive",
            "twoRockEQActive",
            "threeInOneEQActive"
          ],
          "type": "toggle"
        },
        {
          "label": "EQ Low",
          "by": "amp",
          "params": [
            "dumbleLowGain",
            "vibroverbLowGain",
            "twoRockLowGain",
            "threeInOneLowGain"
          ]
        },
        {
          "label": "EQ LoMid",
          "by": "amp",
          "params": [
            "dumbleLowMidGain",
            "vibroverbLowMidGain",
            "twoRockLowMidGain",
            "threeInOneLowMidGain"
          ]
        },
        {
          "label": "EQ HiMid",
          "by": "amp",
          "params": [
            "dumbleHighMidGain",
            "vibroverbHighMidGain",
            "twoRockHighMidGain",
            "threeInOneHighMidGain"
          ]
        },
        {
          "label": "EQ High",
          "by": "amp",
          "params": [
            "dumbleHighGain",
            "vibroverbHighGain",
            "twoRockHighGain",
            "threeInOneHighGain"
          ]
        },
        {
          "label": "Comp On",
          "by": "amp",
          "params": [
            "dumbleCompressorActive",
            "vibroverbCompressorActive",
            "twoRockCompressorActive",
            "threeInOneCompressorActive"
          ],
          "type": "toggle"
        },
        {
          "label": "Comp In",
          "by": "amp",
          "params": [
            "dumbleCompressorInput",
            "vibroverbCompressorInput",
            "twoRockCompressorInput",
            "threeInOneCompressorInput"
          ]
        },
        {
          "label": "Comp Out",
          "by": "amp",
          "params": [
            "dumbleCompressorOutput",
            "vibroverbCompressorOutput",
            "twoRockCompressorOutput",
            "threeInOneCompressorOutput"
          ]
        }
      ]
    },
    {
      "name": "POST FX",
      "controls": [
        {
          "label": "Delay On",
          "type": "toggle",
          "param": "delayActive"
        },
        {
          "label": "Dly Mix",
          "param": "delayMix"
        },
        {
          "label": "Dly Fdbk",
          "param": "delayFeedback"
        },
        {
          "label": "Dly Time",
          "param": "delayTime"
        },
        {
          "label": "Reverb On",
          "type": "toggle",
          "param": "reverbActive"
        },
        {
          "label": "Rev Mix",
          "param": "reverbMix"
        },
        {
          "label": "Rev Decay",
          "param": "reverbDecay"
        },
        {
          "label": "Rev PreDly",
          "param": "reverbPreDelay"
        }
      ]
    },
    {
      "name": "GLOBAL",
      "controls": [
        {
          "label": "Input",
          "param": "inputGain"
        },
        {
          "label": "Output",
          "param": "outputGain"
        },
        {
          "label": "Gate On",
          "type": "toggle",
          "param": "gateActive"
        },
        {
          "label": "Gate Thresh",
          "param": "gateThreshold"
        },
        {
          "label": "Transpose",
          "param": "transpose"
        },
        {
          "label": "Doubler On",
          "type": "toggle",
          "param": "doublerActive"
        },
        {
          "label": "Dblr Spread",
          "param": "doublerSpread"
        }
